<Project>
  <!--
    GakuLoader 公共编译口径。所有 vcxproj 自动继承（MSBuild 向上查找 Directory.Build.props）。
    工具链策略：Visual Studio 2022+ MSVC（v143 / v145），/std:c++20，/utf-8，/MT。
    MinGW 不参与宿主构建，只用于 tests/build-fixtures.ps1 产出异构插件。
  -->
  <PropertyGroup>
    <RepoRoot Condition="'$(RepoRoot)' == ''">$(MSBuildThisFileDirectory)</RepoRoot>
    <GakuDepsDir>$(RepoRoot)deps\</GakuDepsDir>
    <GakuBuildDir>$(RepoRoot)build\</GakuBuildDir>
    <!-- Link-time codegen switch. Kept overridable (/p:GakuLtcg=false) because a
         release-only failure may be an LTCG-visible UB rather than a real bug. -->
    <GakuLtcg Condition="'$(GakuLtcg)' == ''">true</GakuLtcg>
  </PropertyGroup>

  <PropertyGroup>
    <PlatformToolset Condition="'$(PlatformToolset)' == '' and '$(VisualStudioVersion)' &gt;= '18.0'">v145</PlatformToolset>
    <PlatformToolset Condition="'$(PlatformToolset)' == ''">v143</PlatformToolset>
    <!-- 10.0 lets MSBuild resolve an installed Windows SDK. -->
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <CharacterSet>Unicode</CharacterSet>
    <ConfigurationType Condition="'$(ConfigurationType)' == ''">Application</ConfigurationType>
    <OutDir Condition="'$(OutDir)' == ''">$(GakuBuildDir)</OutDir>
    <IntDir>$(GakuBuildDir)obj\$(MSBuildProjectName)\$(Configuration)\</IntDir>
    <GenerateManifest>false</GenerateManifest>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <!-- 源文件含中文注释，必须显式声明 UTF-8；/Zc:__cplusplus 让 __cplusplus 反映真实标准 -->
      <AdditionalOptions>/utf-8 /Zc:__cplusplus %(AdditionalOptions)</AdditionalOptions>
      <WarningLevel>Level4</WarningLevel>
      <!-- MSVC does not enable C++ exceptions by default; std::filesystem and the plugin
           boundary both throw. Without this, catch blocks are skipped and the process dies. -->
      <ExceptionHandling>Sync</ExceptionHandling>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <!-- NOMINMAX: MSVC 的 windows.h 会定义 min/max 宏，掐死 std::min。源码无裸 min/max 用法。 -->
      <PreprocessorDefinitions>WIN32;_WINDOWS;UNICODE;_UNICODE;_CRT_SECURE_NO_WARNINGS;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(RepoRoot)include;$(RepoRoot)src;$(GakuDepsDir)imgui;$(GakuDepsDir)minhook\include;$(GakuDepsDir)minhook\src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <!-- Release：发布物口径。/DEBUG 会把 /OPT:REF、/OPT:ICF 重置为关闭，必须显式打开。 -->
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <WholeProgramOptimization>$(GakuLtcg)</WholeProgramOptimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <LinkTimeCodeGeneration Condition="'$(GakuLtcg)' == 'true'">UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>DebugFull</GenerateDebugInformation>
      <Incremental>false</Incremental>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <BasicRuntimeChecks>EnableFastChecks</BasicRuntimeChecks>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <Incremental>true</Incremental>
    </Link>
  </ItemDefinitionGroup>
</Project>
